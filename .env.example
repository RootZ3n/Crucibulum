# Luak local configuration example.
# Copy to .env for local use.
#
# WARNING: Never commit .env or real provider keys to git.
# .gitignore already excludes .env — do not override that.

# ── Bundle integrity ────────────────────────────────────────────────

# Bundle-signing key (HMAC-SHA256). REQUIRED for the integrity model to mean
# anything. When set, stored evidence bundles are signed and verify to
# signature_status="valid"; the leaderboard ranks only bundles whose signature
# re-checks. When UNSET, bundles carry only a content hash (a public, keyless
# function) and verify to "legacy_unverified" — forged and legitimate bundles
# become indistinguishable, and the public leaderboard quarantines everything.
#
# start.sh auto-generates and persists one here on first launch if absent.
# To set your own: LUAK_HMAC_KEY=$(openssl rand -hex 32). Keep it secret and
# stable — rotating it invalidates the signatures of all previously-stored
# bundles. CRUCIBLE_HMAC_KEY is accepted as a legacy alias.
LUAK_HMAC_KEY=

# ── Provider keys ───────────────────────────────────────────────────

# ModelStudio / DashScope
DASHSCOPE_API_KEY=
MODELSTUDIO_BASE_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1

# Ollama (local models - no key needed)
OLLAMA_BASE_URL=http://localhost:11434

# OpenRouter
OPENROUTER_API_KEY=
# Optional: cap OpenRouter output tokens for every call (chat + agentic).
# Unset = adapter default (8192). Set by experimental cost-capped benchmark
# runs (see docs/MINIMAX_M3_EXPERIMENTAL.md); leave blank for normal use.
# OPENROUTER_MAX_OUTPUT_TOKENS=

# Anthropic
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# MiniMax
MINIMAX_API_KEY=

# Z.ai
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/

# Google AI / Gemini
GOOGLE_AI_API_KEY=

# Groq (ultra-fast inference)
GROQ_API_KEY=

# Mistral AI
MISTRAL_API_KEY=

# Together AI
TOGETHER_API_KEY=

# DeepSeek (direct)
DEEPSEEK_API_KEY=

# Xiaomi MiMo (direct)
MIMO_API_KEY=

# ── Service connections ─────────────────────────────────────────────

CRUCIBULUM_URL=http://localhost:18795
