[Unit]
Description=Luak standalone (web UI + API server)
After=network.target

# Advanced Linux/systemd example only.
# Adjust User, WorkingDirectory, and Environment paths for your deployment.
# The repository quickstart uses npm commands and does not require systemd.

[Service]
Type=simple
User=luak
WorkingDirectory=/opt/luak
Environment=NODE_ENV=production
Environment=LUAK_HOST=127.0.0.1
Environment=LUAK_PORT=18795
Environment=LUAK_STATE_ROOT=/var/lib/luak
ExecStart=/usr/bin/node dist/server/api.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
