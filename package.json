{
  "name": "luak",
  "version": "0.1.0",
  "description": "Auditable scoreboard, receipt, and evidence viewer for model and agent trial outputs",
  "type": "module",
  "author": "Jeffrey Miller",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nousresearch/luak.git"
  },
  "homepage": "https://github.com/nousresearch/luak#readme",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/server/api.js",
  "bin": {
    "luak": "dist/cli/main.js",
    "crucible": "dist/cli/main.js"
  },
  "files": [
    "tsconfig.json",
    "adapters/",
    "cli/",
    "core/",
    "leaderboard/",
    "security/",
    "server/",
    "types/",
    "utils/",
    "tests/",
    "dist/",
    "!dist/tests/",
    "tasks/",
    "oracles/",
    "schemas/",
    "suites/",
    "scripts/",
    "ui/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    ".env.example",
    "crucible.service",
    "luak.service"
  ],
  "scripts": {
    "build": "tsc",
    "build:clean": "node scripts/build-clean.mjs",
    "dev": "tsc --watch",
    "start": "node dist/server/api.js",
    "serve": "node dist/server/api.js",
    "cli": "node dist/cli/main.js",
    "pretest": "node scripts/build-clean.mjs",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "smoke": "node scripts/smoke.mjs",
    "bench:minimax-m3": "node scripts/minimax-m3-bench.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "audit:release": "node scripts/audit-release.mjs",
    "package:windows": "powershell -ExecutionPolicy Bypass -File scripts/package-windows-zip.ps1",
    "doctor": "node scripts/doctor.mjs",
    "clean:state": "node scripts/clean-state.mjs",
    "oracle:hash": "node dist/cli/main.js oracle-hash",
    "harness": "node dist/cli/main.js harness",
    "qa": "node dist/cli/main.js qa",
    "retention:dry-run": "node scripts/retention.mjs --dry-run",
    "retention:clean": "node scripts/retention.mjs --confirm",
    "gauntlet:inventory": "node scripts/release-gauntlet.mjs --dry-run-inventory",
    "gauntlet:mock": "node scripts/release-gauntlet.mjs --mock-only --all-families --write-report"
  },
  "keywords": [
    "ai",
    "evaluation",
    "agent",
    "benchmark",
    "testing",
    "scoreboard",
    "llm",
    "evaluation-framework",
    "model-eval",
    "agent-testing"
  ],
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.4.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
